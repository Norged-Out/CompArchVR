\makeatletter
\newcommand{\@chapteralignment}{\raggedright}

\newcommand{\leftchapter}{\renewcommand{\@chapteralignment}{\raggedright}}
\newcommand{\centerchapter}{\renewcommand{\@chapteralignment}{\centering}}
\newcommand{\rightchapter}{\renewcommand{\@chapteralignment}{\raggedleft}}

% Mirror the template's Contents wording for numbered chapters without
% dragging in the rest of the legacy style file.
\newcommand{\@chaptertype}{\chaptername}

\def\@makechapterhead#1{%
  \vspace*{50\p@}%
  {\parindent \z@ \@chapteralignment \reset@font
    \ifnum \c@secnumdepth >\m@ne
      \huge\bfseries \@chapapp{} \thechapter\par
      \vskip 20\p@
    \fi
    \Huge \bfseries #1\par
    \nobreak
    \vskip 40\p@
  }}

\def\@makeschapterhead#1{%
  \vspace*{50\p@}%
  {\parindent \z@ \@chapteralignment \reset@font
    \Huge \bfseries #1\par
    \nobreak
    \vskip 40\p@
  }}

% Keep chapter headings visually lean in the document, but write the same
% "Chapter N Title" style entries to the table of contents as the template.
\renewcommand{\chapter}{\clearpage
   \renewcommand{\@chaptertype}{\chaptername}%
   \thispagestyle{plain}%
   \global\@topnum\z@
   \@afterindentfalse
   \secdef\@chapter\@schapter
}

\def\@chapter[#1]#2{%
  \ifnum \c@secnumdepth >\m@ne
    \refstepcounter{chapter}%
    \typeout{\@chapapp\space\thechapter.}%
    \addcontentsline{toc}{chapter}%
      {\@chaptertype{} \protect\numberline{\thechapter}#1}%
  \else
    \addcontentsline{toc}{chapter}{\@chaptertype{} #1}%
  \fi
  \chaptermark{#1}%
  \addtocontents{lof}{\protect\addvspace{10\p@}}%
  \addtocontents{lot}{\protect\addvspace{10\p@}}%
  \if@twocolumn
    \@topnewpage[\@makechapterhead{#2}]%
  \else
    \@makechapterhead{#2}%
    \@afterheading
  \fi
}

% Use the same explicit Contents wrapper the template uses so the ToC page
% follows the expected front-matter chapter styling.
\renewcommand\tableofcontents{%
  \if@twocolumn
    \@restonecoltrue\onecolumn
  \else
    \@restonecolfalse
  \fi
  \chapter*{\contentsname
    \@mkboth{\MakeUppercase\contentsname}{\MakeUppercase\contentsname}}%
  \@starttoc{toc}%
  \if@restonecol\twocolumn\fi
}
\makeatother
