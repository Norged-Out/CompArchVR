%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c3dcb87c7fe24f58ad5bf7a170f7e46d, type: 3}
  m_Name: Add
  m_EditorClassIdentifier: 
  displayName: add
  mnemonic: 0
  format: 0
  category: 0
  summary: Add two registers and write the result into a destination register.
  assemblyInstructionText: add t0, t1, t2
  fieldBreakdownText: "opcode: 000000\nrs: t1\nrt: t2\nrd: t0\nfunct: 100000"
  opcodeBits: 000000
  functBits: 100000
  expectedRs: t1
  expectedRt: t2
  expectedRd: t0
  expectedImmediateValue: 0
  touchesDataMemory: 0
  writesRegisterFile: 1
  usesImmediate: 0
  usesDestinationRegister: 1
  initialRegisterValues:
  - registerId: t1
    value: 20
  - registerId: t2
    value: 30
  - registerId: t0
    value: 10
  flowSteps:
  - stepName: Fetch
    highlightedNode: 1
    explanation: The Program Counter holds the address of the next instruction. This is where the fetch phase begins.
    advanceVisualHighlight: 1
    requiredInteraction: 1
    blockProgressUntilValidated: 1
    requiredRegisterSelections: []
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
  - stepName: Instruction Memory
    highlightedNode: 2
    explanation: Instruction Memory uses the PC value to fetch the add instruction. The lesson UI shows the field breakdown for reference.
    advanceVisualHighlight: 1
    requiredInteraction: 1
    blockProgressUntilValidated: 1
    requiredRegisterSelections: []
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
  - stepName: Register Selection
    highlightedNode: 3
    explanation: Decode add by reading rs and rt. Their values will become Read Data 1 and Read Data 2 packets. The destination rd is saved for write-back.
    advanceVisualHighlight: 1
    requiredInteraction: 2
    blockProgressUntilValidated: 1
    requiredRegisterSelections:
    - 1
    - 2
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
  - stepName: ALU Execute
    highlightedNode: 4
    explanation: The ALU adds the values from rs and rt. Because add is R-type, it does not use an immediate and it does not touch Data Memory.
    advanceVisualHighlight: 1
    requiredInteraction: 3
    blockProgressUntilValidated: 1
    requiredRegisterSelections: []
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
  - stepName: Data Memory
    highlightedNode: 5
    explanation: add does not read from or write to Data Memory. This phase is shown anyway so the learner can explicitly recognize that the memory path is skipped before moving to write-back.
    advanceVisualHighlight: 1
    requiredInteraction: 1
    blockProgressUntilValidated: 1
    requiredRegisterSelections: []
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
  - stepName: Write Back
    highlightedNode: 6
    explanation: The ALU result is written back to rd. Confirm the destination register and final value before continuing.
    advanceVisualHighlight: 1
    requiredInteraction: 4
    blockProgressUntilValidated: 1
    requiredRegisterSelections: []
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
  - stepName: Program Counter Update
    highlightedNode: 1
    explanation: Finish the cycle by updating the Program Counter to PC + 4 so the CPU is ready to fetch the next instruction.
    advanceVisualHighlight: 1
    requiredInteraction: 6
    blockProgressUntilValidated: 1
    requiredRegisterSelections: []
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
  - stepName: Recap
    highlightedNode: 1
    explanation: Recap: add fetched the instruction, read rs and rt, used the ALU to add them, skipped Data Memory, wrote the result to rd, and advanced the PC to the next instruction.
    advanceVisualHighlight: 1
    requiredInteraction: 5
    blockProgressUntilValidated: 0
    requiredRegisterSelections: []
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
