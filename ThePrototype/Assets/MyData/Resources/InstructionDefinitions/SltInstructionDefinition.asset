  m_Script: {fileID: 11500000, guid: c3dcb87c7fe24f58ad5bf7a170f7e46d, type: 3}
  m_Name: SltInstructionDefinition
  m_EditorClassIdentifier: 
  displayName: slt
  mnemonic: 4
  format: 0
  category: 0
  summary: Set rd to 1 when rs is less than rt; otherwise set rd to 0.
  assemblyInstructionText: slt t2, t0, t1
  fieldBreakdownText: "opcode: 000000\nrs: t0\nrt: t1\nrd: t2\nfunct: 101010"
  opcodeBits: 000000
  functBits: 101010
  expectedRs: t0
  expectedRt: t1
  expectedRd: t2
  expectedImmediateValue: 0
  touchesDataMemory: 0
  writesRegisterFile: 1
  usesImmediate: 0
  usesDestinationRegister: 1
  initialRegisterValues:
  - registerId: t0
    value: 3
  - registerId: t1
    value: 7
  - registerId: t2
    value: 0
  flowSteps:
  - stepName: Fetch
    highlightedNode: 1
    explanation: The Program Counter supplies the address of the next instruction so Instruction Memory can fetch slt.
    advanceVisualHighlight: 1
    requiredInteraction: 1
    blockProgressUntilValidated: 1
    requiredRegisterSelections: []
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
  - stepName: Instruction Memory
    highlightedNode: 2
    explanation: slt is an R-type instruction. The funct field selects the set-on-less-than comparison.
    advanceVisualHighlight: 1
    requiredInteraction: 1
    blockProgressUntilValidated: 1
    requiredRegisterSelections: []
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
  - stepName: Register Selection
    highlightedNode: 3
    explanation: Read rs and rt from the register file. rd is remembered for write-back.
    advanceVisualHighlight: 1
    requiredInteraction: 2
    blockProgressUntilValidated: 1
    requiredRegisterSelections:
    - 1
    - 2
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
  - stepName: ALU Execute
    highlightedNode: 4
    explanation: The ALU compares rs and rt. If rs is smaller, the ALU result becomes 1; otherwise it becomes 0. Data Memory is skipped.
    advanceVisualHighlight: 1
    requiredInteraction: 3
    blockProgressUntilValidated: 1
    requiredRegisterSelections: []
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
  - stepName: Data Memory
    highlightedNode: 5
    explanation: slt does not touch Data Memory. The lesson will skip this phase and continue to write-back.
    advanceVisualHighlight: 1
    requiredInteraction: 1
    blockProgressUntilValidated: 1
    requiredRegisterSelections: []
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
  - stepName: Write Back
    highlightedNode: 6
    explanation: The comparison result, either 1 or 0, is written back to rd.
    advanceVisualHighlight: 1
    requiredInteraction: 4
    blockProgressUntilValidated: 1
    requiredRegisterSelections: []
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
  - stepName: Recap
    highlightedNode: 6
    explanation: Recap: slt fetched the instruction, read rs and rt, compared them in the ALU, skipped Data Memory, and wrote either 1 or 0 to rd.
    advanceVisualHighlight: 1
    requiredInteraction: 5
    blockProgressUntilValidated: 0
    requiredRegisterSelections: []
    confirmationRegisterRole: 0
    expectedTargetObjectName: 
